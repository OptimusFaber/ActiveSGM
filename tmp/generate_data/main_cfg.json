        "gs_z_levels": [
            [
                35
            ],
            [
                20,
                50
            ]
        ],
        "num_dir_samples": [
            5,
            15
        ],
        "xy_sampling_step": [
            1.0,
            0.5
        ],
        "trans_step_size": 0.1,
        "rot_step_size": 10,
        "surface_dist_thre": 0.5,
        "explore_thre": 0.005,
        "color_ig_thre": 34,
        "depth_ig_thre": 0.01,
        "post_refinement_eval_freq": 100,
        "up_dir": [
            0,
            0,
            1
        ],
        "use_traj_pose": true,
        "SLAMData_dir": "data/Replica/office4"
    },
    "visualizer": {
        "method": "active_lang",
        "vis_rgbd": false,
        "vis_rgbd_max_depth": 10
    },
    "read_base": "<function: read_base>"
