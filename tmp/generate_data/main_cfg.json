{
    "os": "<module: os>",
    "np": "<module: numpy>",
    "general": {
        "dataset": "Replica",
        "scene": "office4",
        "num_iter": 2000,
        "device": "cuda",
        "seed": 0
    },
    "dirs": {
        "data_dir": "data/",
        "result_dir": "tmp/generate_data",
        "cfg_dir": "configs/Replica/office4"
    },
    "sim": {
        "method": "habitat_v2",
        "habitat_cfg": "configs/Replica/office4/habitat.py",
        "center": [
            2,
            0,
            0.2
        ],
        "radius": 1.0
    },
    "slam": {
        "method": "splatam",
        "room_cfg": "configs/Replica/office4/../replica_splatam_s.py",
        "enable_active_planning": true,
        "bbox_bound": [
            [
                -2.1,
                2.5
            ],
            [
                -3.2,
                2
            ],
            [
                -1.3,
                2.0
            ]
        ],
        "bbox_voxel_size": 0.05,
        "surface_dist_thre": 0.5,
        "refine_map_iter": 60,
